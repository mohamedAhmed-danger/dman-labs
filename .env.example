# ─────────────────────────────────────────────────────────────────────────────
# Daman Labs Agent — .env.example
# Copy this file to .env and fill in all values before running the app.
# NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=

# ── MySQL Database ────────────────────────────────────────────────────────────
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DB=
MYSQL_DATABASE=
MYSQL_ROOT_PASSWORD=

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
VECTOR_SIZE=
COLLECTION_NAME=

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=
EMBEDDING_MODEL=

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_MODEL=

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Path to the OAuth credentials JSON downloaded from Google Cloud Console.
GMAIL_CREDENTIALS_PATH=

# ── WAHA (WhatsApp HTTP API) ──────────────────────────────────────────────────
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=

# ── App config ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ITEMS_PER_PAGE=10
FEEDBACK_BASE_URL=
WEBHOOK_THREAD_POOL_SIZE=8
